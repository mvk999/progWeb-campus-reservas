{
  "info": {
    "name": "Campus Reservas API",
    "description": "Rotas da API do Campus Reservas (contrato em docs/api.md). Rode as pastas na ordem, com um banco recém-populado pelo popular_demo. O token CSRF é lido do cookie e enviado em todo POST automaticamente. Antes da pasta 4, defina a senha do responsável com 'python manage.py changepassword demo.c111.responsavel.01' e coloque-a na variável senhaResponsavel da coleção.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "senhaResponsavel",
      "value": "troque-pela-senha-definida"
    },
    {
      "key": "csrftoken",
      "value": ""
    },
    {
      "key": "dataReserva",
      "value": ""
    },
    {
      "key": "reservaId",
      "value": ""
    },
    {
      "key": "reservaId2",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Envia o token CSRF atual em toda requisição POST.",
          "if (pm.request.method === \"POST\") {",
          "    pm.request.headers.upsert({ key: \"X-CSRFToken\", value: pm.collectionVariables.get(\"csrftoken\") });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Guarda o token sempre que o Django criar ou trocar o cookie csrftoken (ex.: no login).",
          "if (pm.cookies.has(\"csrftoken\")) {",
          "    pm.collectionVariables.set(\"csrftoken\", pm.cookies.get(\"csrftoken\"));",
          "}"
        ]
      }
    }
  ],
